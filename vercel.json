{
  "version": 2,
  "name": "scamshield-server",
  "framework": null,
  "installCommand": "npm --prefix server install",
  "buildCommand": "echo \"ScamShield backend deployed\"",
  "functions": {
    "api/index.mjs": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
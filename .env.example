# ScamShield AI — environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.

# ============================================================
# SERVER
# ============================================================
PORT=3001
# NODE_ENV=production enables production guards (JWT secret required,
# CORS locked down). Leave unset for local development.
# NODE_ENV=production

# ============================================================
# DATABASE — Turso (libSQL)
# ------------------------------------------------------------
# LOCAL DEVELOPMENT: leave both blank. The server uses an embedded
# libSQL file at server/data/scamshield.db automatically — no account needed.
#
# PRODUCTION (Netlify): create a free Turso database and set:
#   TURSO_DATABASE_URL=libsql://<your-db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create <db>`>
# Never commit the real auth token.
# ============================================================
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ============================================================
# LIVE AI (optional)
# Leave AI_API_KEY empty to run in DEMO MODE — the built-in
# deterministic threat-intelligence engine handles everything.
# ============================================================
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
# For screenshot / image analysis use a vision-capable model:
# AI_MODEL_IMAGE=gpt-4o-mini

# ============================================================
# CORS — comma-separated list of allowed browser origins.
# In development you can leave this empty (all origins allowed).
# In production set this to your frontend URL.
# ============================================================
CORS_ORIGIN=http://localhost:5173

# ============================================================
# AUTH
# Set a long random string for JWT_SECRET in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================
JWT_SECRET=change-me-to-a-long-random-string

# ============================================================
# GOOGLE OAUTH (optional)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add your redirect URI as an Authorized redirect URI.
# Leave empty to disable real Google sign-in; the demo button still works.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ============================================================
# EMAIL (OTP codes + clickable email verification) — Brevo
# ------------------------------------------------------------
# REAL DELIVERY requires a provider:
#   EMAIL_PROVIDER=brevo   + BREVO_API_KEY   → Brevo transactional API (recommended)
#   EMAIL_PROVIDER=smtp    + SMTP_*          → your own SMTP server
#   EMAIL_PROVIDER=console                    → dev-only: prints to server console
#
# Brevo setup:
#   1. Create a free Brevo account (https://www.brevo.com)
#   2. Create a transactional API key (SMTP & API → API Keys)
#   3. Verify a sender address or domain (Senders & IP)
#   4. Set BREVO_API_KEY and EMAIL_FROM (must use the verified sender)
# The Brevo key is server-only — never put it in a VITE_* variable.
# ============================================================
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_TIMEOUT_MS=15000

# SMTP alternative (leave blank if using Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender must be a Brevo-verified sender/domain in production.
EMAIL_FROM=ScamShield AI <no-reply@scamshield.app>

# Public base URL used to build the email-verification link.
# Production example: https://myscamshield-ai.netlify.app
# Local dev: leave blank to default to http://localhost:5173
APP_PUBLIC_URL=

# OTP behaviour
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ============================================================
# EXTERNAL REPUTATION INTELLIGENCE (all optional)
#
# Leave empty to run without external reputation checks.
# When absent, status is "not_configured" — never fabricated.
# When a provider errors or times out: "verification_unavailable".
#
# VirusTotal — https://www.virustotal.com/gui/my-apikey
# Free tier: 4 requests/min, 500 req/day
# ============================================================
VIRUSTOTAL_API_KEY=

# Google Safe Browsing — https://developers.google.com/safe-browsing/v4/get-started
# Free tier: 10,000 req/day
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/api
# Used for IP-address URLs only. Free tier: 1,000 req/day
ABUSEIPDB_API_KEY=

# ============================================================
# FRONTEND (Vite)
# VITE_API_BASE is empty in development (uses Vite proxy).
# In production set it to your deployed backend URL:
#   VITE_API_BASE=https://your-backend.onrender.com
# ============================================================
VITE_PORT=5173
VITE_API_BASE=
# ScamShield AI — environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.

# ============================================================
# SERVER
# ============================================================
PORT=3001

# ============================================================
# LIVE AI (optional)
# Leave AI_API_KEY empty to run in DEMO MODE — the built-in
# deterministic threat-intelligence engine handles everything.
# ============================================================
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
# For screenshot / image analysis use a vision-capable model:
# AI_MODEL_IMAGE=gpt-4o-mini

# ============================================================
# CORS — comma-separated list of allowed browser origins.
# In development you can leave this empty (all origins allowed).
# In production set this to your frontend URL.
# ============================================================
CORS_ORIGIN=http://localhost:5173

# ============================================================
# AUTH
# Set a long random string for JWT_SECRET in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================
JWT_SECRET=change-me-to-a-long-random-string

# ============================================================
# GOOGLE OAUTH (optional)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add your redirect URI as an Authorized redirect URI.
# Leave empty to disable real Google sign-in; the demo button still works.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ============================================================
# EMAIL OTP (verification codes)
# REAL DELIVERY requires an email provider:
#   EMAIL_PROVIDER=resend  + RESEND_API_KEY  → Resend (https://resend.com)
#   EMAIL_PROVIDER=smtp    + SMTP_*          → Gmail / your SMTP server
#   EMAIL_PROVIDER=console                    → dev-only: code prints to server console
# ============================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ScamShield AI <onboarding@resend.dev>

# OTP behaviour
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ============================================================
# EXTERNAL REPUTATION INTELLIGENCE (all optional)
#
# Leave empty to run without external reputation checks.
# When absent, status is "not_configured" — never fabricated.
# When a provider errors or times out: "verification_unavailable".
#
# VirusTotal — https://www.virustotal.com/gui/my-apikey
# Free tier: 4 requests/min, 500 req/day
# ============================================================
VIRUSTOTAL_API_KEY=

# Google Safe Browsing — https://developers.google.com/safe-browsing/v4/get-started
# Free tier: 10,000 req/day
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/api
# Used for IP-address URLs only. Free tier: 1,000 req/day
ABUSEIPDB_API_KEY=

# ============================================================
# FRONTEND (Vite)
# VITE_API_BASE is empty in development (uses Vite proxy).
# In production set it to your deployed backend URL:
#   VITE_API_BASE=https://your-backend.onrender.com
# ============================================================
VITE_PORT=5173
VITE_API_BASE=